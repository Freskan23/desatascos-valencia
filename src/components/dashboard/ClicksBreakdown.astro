---
interface Props {
  title: string;
  rows: { label: string; value: number; color: string }[];
}
const { title, rows } = Astro.props;
const max = Math.max(...rows.map((r) => r.value));
const total = rows.reduce((s, r) => s + r.value, 0);
---
<div class="chart-card">
  <div class="chart-head">
    <h3>{title}</h3>
    <span class="chart-caption">datos de ejemplo</span>
  </div>
  <div class="ranking">
    {rows.map((r) => (
      <div class="row">
        <span class="row-label"><i style={`background:${r.color}`}></i>{r.label}</span>
        <div class="bar-track">
          <div class="bar-fill" style={`width:${(r.value / max) * 100}%;background:${r.color}`}></div>
        </div>
        <span class="row-value">{r.value}</span>
      </div>
    ))}
  </div>
  <p class="total">{total} clics totales (7 días)</p>
</div>
<style>
  .chart-card{background:var(--surface,#fff);border:1px solid var(--border,#e2e8f0);border-radius:14px;padding:22px;}
  .chart-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px;}
  .chart-head h3{font-size:14px;font-weight:700;color:var(--ink,#0f172a);}
  .chart-caption{font-size:11px;color:var(--ink-muted,#64748b);}
  .ranking{display:flex;flex-direction:column;gap:13px;}
  .row{display:grid;grid-template-columns:104px 1fr 32px;align-items:center;gap:10px;}
  .row-label{font-size:12.5px;color:var(--ink,#0f172a);display:flex;align-items:center;gap:7px;white-space:nowrap;}
  .row-label i{width:9px;height:9px;border-radius:3px;flex-shrink:0;display:inline-block;}
  .bar-track{height:12px;background:#f1f5f9;border-radius:6px;overflow:hidden;}
  .bar-fill{height:100%;border-radius:6px;min-width:4px;}
  .row-value{font-size:12px;font-weight:700;color:var(--ink,#0f172a);text-align:right;font-variant-numeric:tabular-nums;}
  .total{margin-top:14px;padding-top:12px;border-top:1px solid var(--border,#e2e8f0);font-size:11.5px;color:var(--ink-muted,#64748b);}
</style>
