---
export const prerender = false;
import Dashboard from '@/layouts/Dashboard.astro';
import StatTile from '@/components/dashboard/StatTile.astro';
import TrendChart from '@/components/dashboard/TrendChart.astro';
import RankingBars from '@/components/dashboard/RankingBars.astro';
import { getSecret } from '@/lib/secrets';
import { getGA4Summary, type GA4Summary } from '@/lib/ga4';
import { getGSCSummary, type GSCSummary } from '@/lib/gsc';

const [credentialsJson, propertyId, siteUrl] = await Promise.all([
  getSecret('GOOGLE_SERVICE_ACCOUNT_JSON'),
  getSecret('GA4_PROPERTY_ID'),
  getSecret('GSC_SITE_URL'),
]);

let ga4: GA4Summary | null = null;
let ga4Error: string | null = null;
if (credentialsJson && propertyId) {
  try {
    ga4 = await getGA4Summary({ propertyId, credentialsJson });
  } catch (err) {
    ga4Error = String(err).slice(0, 300);
  }
} else {
  ga4Error = 'GA4 no configurado — añade la credencial y el Property ID en Configuración.';
}

let gsc: GSCSummary | null = null;
let gscError: string | null = null;
if (credentialsJson && siteUrl) {
  try {
    gsc = await getGSCSummary({ siteUrl, credentialsJson });
  } catch (err) {
    gscError = String(err).slice(0, 300);
  }
} else {
  gscError = 'Search Console no configurado — añade la credencial y el Site URL en Configuración.';
}

const fmtNum = (n: number) => n.toLocaleString('es-ES');
const fmtDec = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

const kpis = [
  { label: 'Visitas (GA4)', value: ga4 ? fmtNum(ga4.sessions) : '—' },
  { label: 'Clics en búsqueda (GSC)', value: gsc ? fmtNum(gsc.clicks) : '—' },
  { label: 'CTR orgánico', value: gsc ? fmtDec(gsc.ctr) + '%' : '—' },
  { label: 'Posición media', value: gsc ? fmtDec(gsc.avgPosition) : '—' },
];
---
<Dashboard title="SEO — Rendimiento y adquisición">
  <div class="grid">
    <div class="card welcome">
      <h2>Rendimiento web — datos en vivo</h2>
      <p>Conectado a Google Analytics 4 y Search Console. Leads/CTA por página está pendiente de cablear (necesita el pipeline interno de leads).</p>
    </div>
    <div class="kpis">
      {kpis.map((k) => <StatTile label={k.label} value={k.value} />)}
    </div>

    <div class="cols-2">
      {ga4Error && <div class="chart-card empty"><h3>Visitas orgánicas · últimos 14 días</h3><p class="empty-msg">⚠ {ga4Error}</p></div>}
      {ga4 && ga4.trend.length === 0 && !ga4Error && (
        <div class="chart-card empty"><h3>Visitas orgánicas · últimos 14 días</h3><p class="empty-msg">Sin visitas registradas todavía en GA4 — aparecerán aquí en cuanto entre tráfico.</p></div>
      )}
      {ga4 && ga4.trend.length > 0 && (
        <TrendChart title="Visitas orgánicas · últimos 14 días" data={ga4.trend} caption="Google Analytics 4" />
      )}

      <div class="chart-card empty">
        <h3>Leads confirmados · últimos 14 días</h3>
        <p class="empty-msg">Pendiente — falta conectar el pipeline de leads (Fase 3). No se muestran cifras hasta que haya datos reales.</p>
      </div>
    </div>

    <div class="cols-3">
      {ga4Error && <div class="chart-card empty"><h3>Fuentes de tráfico</h3><p class="empty-msg">⚠ {ga4Error}</p></div>}
      {ga4 && ga4.sources.length === 0 && !ga4Error && (
        <div class="chart-card empty"><h3>Fuentes de tráfico</h3><p class="empty-msg">Sin datos todavía.</p></div>
      )}
      {ga4 && ga4.sources.length > 0 && (
        <RankingBars title="Fuentes de tráfico" rows={ga4.sources} unit="%" caption="Google Analytics 4" />
      )}

      <div class="chart-card empty">
        <h3>Conversiones por CTA</h3>
        <p class="empty-msg">Pendiente — falta conectar los eventos de la web (Fase 2).</p>
      </div>

      <div class="chart-card">
        <div class="chart-head"><h3>Páginas mejor posicionadas</h3><span class="chart-caption">Search Console</span></div>
        {gscError && <p class="empty-msg">⚠ {gscError}</p>}
        {gsc && gsc.topPages.length === 0 && !gscError && <p class="empty-msg">Sin clics registrados todavía en Search Console.</p>}
        {gsc && gsc.topPages.length > 0 && (
          <table class="pages-table">
            <thead><tr><th>Página</th><th>Clics</th><th>CTR</th></tr></thead>
            <tbody>
              {gsc.topPages.map((p) => (
                <tr><td>{p.page}</td><td>{p.clicks}</td><td>{p.ctr}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  </div>
  <style>
    .grid{display:flex;flex-direction:column;gap:20px;}
    .card{background:#fff;border:1px solid var(--border,#e2e8f0);border-radius:14px;padding:24px;}
    .welcome h2{font-size:18px;margin-bottom:8px;}
    .welcome p{color:#64748b;font-size:14px;line-height:1.6;}
    .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
    .cols-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
    .cols-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;}
    .chart-card{background:#fff;border:1px solid var(--border,#e2e8f0);border-radius:14px;padding:22px;}
    .chart-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px;}
    .chart-head h3{font-size:14px;font-weight:700;color:var(--ink,#0f172a);}
    .chart-caption{font-size:11px;color:var(--ink-muted,#64748b);}
    .chart-card.empty h3{font-size:14px;font-weight:700;color:var(--ink,#0f172a);margin-bottom:10px;}
    .empty-msg{font-size:12.5px;color:var(--ink-muted,#64748b);line-height:1.6;}
    .pages-table{width:100%;border-collapse:collapse;font-size:12.5px;}
    .pages-table th{text-align:left;font-size:10.5px;text-transform:uppercase;color:var(--ink-muted,#64748b);padding:0 6px 8px;border-bottom:1px solid var(--border,#e2e8f0);}
    .pages-table td{padding:8px 6px;border-bottom:1px solid #f1f5f9;color:var(--ink,#0f172a);}
    @media(max-width:900px){.kpis{grid-template-columns:repeat(2,1fr);}.cols-2,.cols-3{grid-template-columns:1fr;}}
  </style>
</Dashboard>
